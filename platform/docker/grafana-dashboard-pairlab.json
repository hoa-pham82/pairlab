{
  "title": "Pairlab Platform",
  "uid": "pairlab-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API \u2014 Requests",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "signal_api \u2014 request rate (req/s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"signal_api\"}[1m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "regime_api \u2014 request rate (req/s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"regime_api\"}[1m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "signal_api \u2014 p50/p95/p99 latency (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"signal_api\"}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"signal_api\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"signal_api\"}[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "regime_api \u2014 p50/p95/p99 latency (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"regime_api\"}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"regime_api\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"regime_api\"}[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Drift Monitoring",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Drift Detected",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "pairlab_drift_detected",
          "legendFormat": "{{pair_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "DRIFT",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Spread change PSI by pair",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 16
      },
      "targets": [
        {
          "expr": "pairlab_spread_change_psi",
          "legendFormat": "{{pair_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 0.2
                    }
                  ]
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "line"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Z-score PSI",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "targets": [
        {
          "expr": "pairlab_zscore_psi",
          "legendFormat": "{{pair_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 0.2
                    }
                  ]
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "line"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Drift DAG last run (seconds ago)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "time() - pairlab_drift_last_run_seconds",
          "legendFormat": "seconds since last drift check"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Container Resources (cAdvisor)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "CPU usage by container (%)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Memory usage by container (MB)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name!=\"\"} / 1024 / 1024",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "megabytes"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Network I/O (bytes/s)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[1m])",
          "legendFormat": "rx {{name}}"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[1m])",
          "legendFormat": "tx {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "LLM (llama.cpp)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "LLM prompt tokens/s",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "rate(llamacpp_prompt_tokens_total[1m])",
          "legendFormat": "prompt tok/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "LLM generation tokens/s",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "expr": "rate(llamacpp_tokens_predicted_total[1m])",
          "legendFormat": "gen tok/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Agent A/B: answers by variant and outcome (req/min)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "expr": "sum by (variant, outcome) (rate(agent_ab_requests_total[5m])) * 60",
          "legendFormat": "{{variant}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Agent A/B: p95 answer time by variant (s)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, variant) (rate(agent_ab_seconds_bucket[5m])))",
          "legendFormat": "{{variant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ]
}