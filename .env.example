# Copy to .env and fill in — never commit .env
POSTGRES_URL=postgresql://pairlab:pairlab@localhost:5432/pairlab
MINIO_ENDPOINT=http://localhost:4566
MINIO_ROOT_USER=your-access-key          # min 3 chars (MinIO root user)
MINIO_ROOT_PASSWORD=your-secret-key      # min 8 chars (MinIO root password)
MLFLOW_TRACKING_URI=http://localhost:5000
REDPANDA_BROKERS=localhost:9092
OLLAMA_BASE_URL=http://localhost:11434
# Gateway (NGINX Basic Auth) — change before exposing to a network
GATEWAY_USER=pairlab
GATEWAY_PASSWORD=pairlab
# Vault (dev mode) — token set to VAULT_DEV_ROOT_TOKEN_ID
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=pairlab-root
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=
